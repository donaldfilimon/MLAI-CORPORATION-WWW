# ── WorkOS AuthKit ───────────────────────────────────────────────────────────
# Get these from https://dashboard.workos.com → API Keys
WORKOS_API_KEY="sk_..."
WORKOS_CLIENT_ID="client_..."

# ── Session ───────────────────────────────────────────────────────────────────
# A random 32+ char secret used to seal the encrypted session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-char-secret"

# ── App ───────────────────────────────────────────────────────────────────────
# REQUIRED IN EVERY DEPLOYED ENVIRONMENT — not optional, despite the fallback.
# Full origin where the app is served. workos.ts builds the OAuth redirect URI
# as ${APP_URL}/api/auth/callback and falls back to http://localhost:3000, which
# is not a registered WorkOS redirect — so an unset APP_URL means login and
# signup fail for every visitor while the pages still return 200. The same
# origin must be allowlisted in the WorkOS dashboard.
# On Cloud Run this is a repo VARIABLE (not a Secret Manager entry) consumed by
# .github/workflows/deploy-cloudrun.yml, which fails the deploy if it is unset.
APP_URL="https://your-cloudrun-url.run.app"

# Server port. Nothing in src/ or app/ reads process.env.PORT — it is consumed
# by `next start`, which binds it when the PROCESS environment provides it
# (Cloud Run, Render and Fly inject it). Leave this commented out: `next start`
# already defaults to 3000, `bun run dev` pins 3000, and `bun run smoke` /
# `bun run crawl` both assume :3000. Set it in the platform, not here.
# PORT=3000

# SQLite path for inquiries + telemetry (node:sqlite DatabaseSync). Accepts a
# bare path or a "sqlite://" prefix, either form is stripped to a path. Unset
# defaults to "inquiries.db" (relative to the process CWD — ephemeral on most
# platforms). For persistence on Cloud Run or any platform with a mounted
# volume, point this at the mount (the image prepares /app/data, chowned to
# the non-root runtime user — see Dockerfile):
#   DATABASE_URL="/app/data/inquiries.db"
# NOTE: the Cloud Run deploy sets that path but mounts NO volume there, so it is
# in-memory tmpfs and the data does not survive a redeploy. See
# docs/deploy-cloud-run.md → "Persisting the SQLite database".
DATABASE_URL="inquiries.db"

# Optional: where the frontend is served, if different from APP_URL.
# Genuinely optional — but it must be UNSET rather than empty. workos.ts uses
# `process.env.FRONTEND_URL ?? APP_URL`, and ?? does not catch "", so an empty
# value defeats the fallback and makes post-auth redirects throw on
# `new URL(path, "")`. The deploy workflow omits the key entirely when the
# FRONTEND_URL repo variable is blank, for exactly this reason. So this line
# stays COMMENTED OUT: copying it as an empty assignment would break local auth.
# FRONTEND_URL="https://your-frontend-origin.example"

# ── LLM provider (optional) ───────────────────────────────────────────────────
# Two providers are implemented: gemini and anthropic. With NEITHER key set,
# /api/llm/* returns a safe scaffolded fallback response.
#
# LLM_PROVIDER is AUTHORITATIVE when set — it does not fall through. Leaving it
# as "gemini" while setting only ANTHROPIC_API_KEY yields the scaffold, and
# /api/llm/status reports provider "gemini", configured false. Leave it BLANK to
# auto-detect from whichever key is present (Gemini wins if both are set).
LLM_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
# Anthropic — the second implemented provider. Set LLM_PROVIDER="anthropic" or
# leave it blank with only this key set.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_MAX_TOKENS="1024"

# ── Billing (optional) ────────────────────────────────────────────────────────
# Without STRIPE_PAYMENT_LINK, /api/billing/checkout returns 503 with guidance.
BILLING_PROVIDER="manual"
STRIPE_PAYMENT_LINK=""

# ── Admin reads ───────────────────────────────────────────────────────────────
# Comma-separated allowlist for GET /api/inquiries and GET /api/telemetry/summary.
# FAILS CLOSED in production: leave this unset and those endpoints 403 for
# everyone, with nothing in the response explaining why. (In development an
# unset list is allowed through, with a warning.)
ADMIN_EMAILS=""

# Require an enrolled WorkOS MFA factor for admin reads (inquiries, telemetry summary).
# See docs/mfa-workos-runbook.md for the dashboard + rollout steps.
ADMIN_REQUIRE_MFA="false"
