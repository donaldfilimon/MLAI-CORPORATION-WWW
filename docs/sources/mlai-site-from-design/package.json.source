{
  "name": "mlai-site",
  "version": "2.2.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build:scripts": "bun build scripts/neural.ts scripts/canvases.ts --outdir public --target browser --minify",
    "dev": "bun run build:scripts && bun --bun run next dev",
    "build": "bun run build:scripts && bun --bun run next build",
    "start": "bun --bun run next start",
    "typecheck": "bun --bun run tsc --noEmit",
    "lint": "bun --bun run next lint",
    "test": "bun test"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "typescript": "^5.6.0"
  }
}
