APP_URL=http://127.0.0.1:3100
# Runtime data, credentials and private uploads remain outside version control.
MLAI_DATA_DIR=.data
MAX_UPLOAD_MB=100
DOCUMENT_TIMEOUT_SECONDS=300
WORKER_CONCURRENCY=2
# Connections are operator-owned, never submitted as arbitrary browser URLs.
# MLAI_CONNECTIONS_FILE=/absolute/private/path/connections.json
# Initial local connection defaults; an existing registry takes precedence.
# MLAI_LOCAL_MODEL_URL=http://127.0.0.1:3102/v1
# MLAI_LOCAL_MODEL_ID=mlx-community/Llama-3.2-3B-Instruct-4bit
# MLAI_JAVA=/absolute/path/to/java
# MLAI_TIKA_JAR=/absolute/path/to/tika-app-3.3.2.jar

# Optional independent WDBX playground launcher (existing binary, new private store)
# MLAI_WDBX_BINARY=/absolute/path/to/abi-wdbx-gateway
