{
  "name": "mlai-website-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "node ./scripts/refuse-deploy.mjs",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc",
    "verify": "bun run test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@vercel/connect": "1.0.0",
    "ai": "^7.0.82",
    "eve": "^0.52.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  }
}
