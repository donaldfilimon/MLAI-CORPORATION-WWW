# Quesar local development environment. Production values are split between
# GitHub Actions variables and Google Secret Manager; see infra/README.md.

# ── Canonical application origin ─────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Leave FRONTEND_URL unset unless it is a genuinely different origin that
# preserves the OAuth state-cookie topology.
# FRONTEND_URL="https://frontend.example"

# ── WorkOS AuthKit + invite-only organization ────────────────────────────────
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
WORKOS_ORGANIZATION_ID="org_..."

# 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-random-characters"

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Local development uses an ordinary Postgres URL. Production leaves this
# unset and uses the Cloud SQL Unix socket fields below.
DATABASE_URL="postgres://quesar:quesar@127.0.0.1:5432/quesar"
DATABASE_SSL="disable"
DATABASE_POOL_SIZE="5"

# Production Cloud Run fields (normally injected by deploy-cloudrun.yml):
# CLOUD_SQL_CONNECTION_NAME="project:us-east1:quesar-postgres"
# DATABASE_NAME="quesar"
# DATABASE_USER="quesar_app"
# DATABASE_PASSWORD="stored-in-google-secret-manager"

# ── Gemini 3.7 Flash through Cloudflare AI Gateway ───────────────────────────
# The server intentionally has no direct Gemini/Anthropic fallback. The gateway
# URL ends at the OpenAI-compatible /compat endpoint; the token is server-only.
CLOUDFLARE_AI_GATEWAY_URL="https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1/chat/completions"
CLOUDFLARE_AI_GATEWAY_ID="quesar"
CLOUDFLARE_AI_GATEWAY_TOKEN="replace-with-authenticated-gateway-token"

# ── Encrypted one-year conversation audits ──────────────────────────────────
# Full CryptoKey resource name. Local use requires Google ADC with KMS access.
AUDIT_KMS_KEY_NAME="projects/PROJECT/locations/us-east1/keyRings/quesar-audit/cryptoKeys/conversation-audits"
# 32+ random characters; this pseudonymizes WorkOS user IDs before persistence.
AUDIT_SUBJECT_PEPPER="replace-with-at-least-32-random-characters"

# Daily Cloud Scheduler OIDC identity. The endpoint fails closed if either is
# absent; local development does not need to call the expiry endpoint.
AUDIT_SCHEDULER_SERVICE_ACCOUNT="quesar-audit-scheduler@PROJECT.iam.gserviceaccount.com"
AUDIT_SCHEDULER_AUDIENCE="https://quesar.cloud/api/internal/audits/expire"

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# These are Cloudflare's official always-pass DEVELOPMENT keys. They work only
# as a pair and must never be placed in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"

# ── Administrative reads ─────────────────────────────────────────────────────
# Production fails closed without an allowlist and always sets MFA enforcement.
ADMIN_EMAILS=""
ADMIN_REQUIRE_MFA="false"
# Set true only after an operator has verified the Required MFA policy in the
# production WorkOS Dashboard. Production admin routes fail closed otherwise.
WORKOS_MFA_POLICY_VERIFIED="false"
# Set true only after the organization's SSO identity provider is verified to
# require MFA. Keep false to deny SSO sessions administrative access.
WORKOS_SSO_MFA_POLICY_VERIFIED="false"

# ── Optional billing scaffold ────────────────────────────────────────────────
BILLING_PROVIDER="manual"
STRIPE_PAYMENT_LINK=""
