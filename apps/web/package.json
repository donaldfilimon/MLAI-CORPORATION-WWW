{
  "name": "@mlai/web",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "bun scripts/generate-sitemap.ts && next build",
    "start": "next start",
    "sitemap": "bun scripts/generate-sitemap.ts",
    "clean": "rm -rf .next dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "crawl": "bun scripts/crawl-links.mjs",
    "smoke": "bash scripts/smoke-api.sh",
    "og": "python3 scripts/generate-og.py",
    "audit:expire": "bun scripts/expire-audits.ts",
    "design-sync:css": "bun scripts/design-sync-css.mjs",
    "research:export": "bun scripts/export-research.tsx"
  },
  "dependencies": {
    "@mlai/contracts": "file:../../packages/contracts",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@google-cloud/kms": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tensorflow-models/posenet": "^2.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@workos-inc/node": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "google-auth-library": "^11.0.2",
    "iron-session": "^8.0.4",
    "katex": "^0.17.0",
    "lucide-react": "^1.41.0",
    "next": "^15.5.25",
    "postgres": "^3.4.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
